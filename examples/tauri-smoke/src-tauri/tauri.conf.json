{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Release QA Smoke",
  "version": "0.1.0",
  "identifier": "dev.frogbyte.releaseqa.smoke",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Release QA Smoke", "width": 480, "height": 320 }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
